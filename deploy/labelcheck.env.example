# labelcheck runtime configuration — example.
#
# On the box this file lives at /etc/labelcheck.env and is read by both units
# (EnvironmentFile=-/etc/labelcheck.env). Every value below is the shipped default, so an
# empty file behaves identically to this one; uncomment only what you are deliberately
# changing. Values are read by app/config.py as LABELCHECK_<SETTING_NAME_UPPERCASED>.
#
# deploy/bench-on-box.sh REWRITES this file with the resolution knobs it measured on the
# box (the p95-driven ones marked "tuned by bench" below). Anything else you set here by
# hand will be lost on the next deploy — put durable changes in the unit instead.
#
# Syntax note: systemd EnvironmentFile takes bare KEY=value lines. No `export`, no shell
# expansion, no inline comments after a value.

# --- Service ---------------------------------------------------------------------------
# Directory holding the SQLite database, uploads/ and crops/. The shipped default is a
# relative .data for local development; the unit sets /var/lib/labelcheck (a systemd
# StateDirectory) and that setting wins over anything written here.
#LABELCHECK_DATA_DIR=.data
# TCP port uvicorn binds on 127.0.0.1; nginx proxies to it. Also fixed by the unit.
#LABELCHECK_PORT=8712
# ONNX Runtime intra/inter-op threads. 2 = the box's vCPU count; every measured latency
# figure in the design is a 2-thread figure.
#LABELCHECK_OCR_THREADS=2

# --- OCR resolution ladder (tuned by bench) ---------------------------------------------
# Pass 1 runs on the whole frame downscaled to this long side. 960 costs 1.6-1.8 s against
# 2.5-4.0 s at native resolution for -0.0009 warning accuracy.
#LABELCHECK_PASS1_LONG_SIDE=960
# Pass 2 re-reads the warning band at this long side. On a 2400 px ingest frame a band crop
# at 960 magnifies the statement rather than shrinking it.
#LABELCHECK_PASS2_LONG_SIDE=960
# crop = re-read only the located warning band (default), full = re-read the whole frame,
# off = never escalate.
#LABELCHECK_PASS2_MODE=crop
# Frame the stroke-weight measurement runs on. Bounds patch cost for 12 MP phone photos.
#LABELCHECK_BOLD_LONG_SIDE=1600
# Below this measured cap height the stroke-width ratio carries no signal, so the bold
# check abstains (amber) instead of guessing.
#LABELCHECK_BOLD_MIN_CAP_PX=11

# --- Ingest -----------------------------------------------------------------------------
# Every upload is re-encoded to JPEG at this long side, which strips metadata and any
# EXIF-borne payload and normalises orientation once, at the boundary.
#LABELCHECK_INGEST_LONG_SIDE=2400
#LABELCHECK_INGEST_JPEG_QUALITY=92

# --- Latency budget ----------------------------------------------------------------------
# Per-image target. Median is ~2.7 s and p95 ~4.4 s on the reference machine.
#LABELCHECK_BUDGET_MS=5000
# Time held back for the bold stage, verdict and serialisation. If the elapsed time plus
# the running estimate of pass 2 would exceed budget minus this reserve, pass 2 is skipped
# and the result is marked low_confidence (which can never produce a red).
#LABELCHECK_PASS2_RESERVE_MS=400

# --- Escalation to pass 2 (measured policy: 57% of the corpus, 0 false positives) --------
# Escalate when the clause-1 fuzzy score falls below this.
#LABELCHECK_ESC_PREFIX_MIN=75.0
# Escalate when the whole-statute fuzzy score falls below this.
#LABELCHECK_ESC_REGION_MIN=95.0
# Escalate whenever pass 1 read the prefix as anything but capitals: any read that implies
# a rejection is re-verified before the app rejects.
#LABELCHECK_ESC_REQUIRE_CAPS=true

# --- Warning text comparison --------------------------------------------------------------
# TRUST gate. Below this clause-1 score the text check can only return amber, never red —
# a damaged read must never become a rejection.
#LABELCHECK_TEXT_TRUST_MIN=95.0
# Above TRUST but below this whole-statute score, the deficiency is in the label, so the
# word-level diff decides.
#LABELCHECK_TEXT_REGION_MIN=90.0
# Fraction of the 43 statute tokens allowed to be OCR noise in a green verdict.
#LABELCHECK_NOISE_GREEN_MAX_RATIO=0.15
# rapidfuzz ratio at or above which two tokens differing only in known OCR confusions
# (0/O, 1/l/I, 5/S, 8/B, rn/m, cl/d, vv/w) count as noise rather than a substitution.
#LABELCHECK_NOISE_WORD_MIN_SIM=80

# --- Warning presence and case -------------------------------------------------------------
# partial_ratio("government warning", page text) at or above this means the statement is
# present. Measured 100.0 on warning-bearing labels, 44.4 on the rest.
#LABELCHECK_ANCHOR_MIN=80.0
# With no anchor and fewer readable tokens than this, the image is unreadable (amber)
# rather than a label with no warning (red).
#LABELCHECK_MIN_TOKENS_FOR_ABSENCE=12
# Uppercase ratio over the matched "GOVERNMENT WARNING" span. One OCR glyph slip gives
# 0.941, genuine title case gives 0.12 — never string equality.
#LABELCHECK_CASE_CAPS_MIN=0.90
#LABELCHECK_CASE_TITLE_MAX=0.40

# --- Bold (27 CFR 16.22(a)(2)) ---------------------------------------------------------------
# prefix stroke width / body stroke width. Compliant labels measure 1.11-1.60, violations
# 0.91-1.14; between the two cuts the answer is amber.
#LABELCHECK_BOLD_T_PASS=1.20
#LABELCHECK_BOLD_T_FAIL=1.05
# Defocus gate, evaluated first and unconditionally: below this normalised Laplacian
# variance the ink cannot be measured, so the check abstains. Without it a blurred
# violation inflates past T_PASS and becomes a confident false PASS.
#LABELCHECK_BOLD_T_SHARP=0.20
# body / in-image reference stroke width at or above which the likely violation is
# "whole statement bold" rather than "prefix not bold". Selects the subtype only.
#LABELCHECK_BOLD_T_REF=1.20
# Fallback for labels with no usable reference text: absolute normalised body stroke width.
#LABELCHECK_BOLD_T_ABS=0.0785

# --- Record matching (no CFR citation — see the approach document) ----------------------------
# Fuzzy score bands for brand name: at or above green, below amber is red.
#LABELCHECK_BRAND_GREEN=92
#LABELCHECK_BRAND_AMBER=80
# Same for class/type. Note this rule is unvalidated by measurement: the corpus contains no
# class/type mismatch.
#LABELCHECK_CLASS_GREEN=90
#LABELCHECK_CLASS_AMBER=75

# --- Reading order -----------------------------------------------------------------------------
# Rotate detected box centroids by the estimated skew before clustering them into lines.
# Targets rotated photographs; ships on, with the golden run printing the A/B.
#LABELCHECK_READING_ORDER_DESKEW=true

# --- Limits and retention ------------------------------------------------------------------------
# 12 MiB per image (nginx allows 16m so the app returns its own message).
#LABELCHECK_MAX_UPLOAD_BYTES=12582912
#LABELCHECK_MAX_BATCH_IMAGES=400
# 2 MiB records CSV.
#LABELCHECK_MAX_CSV_BYTES=2097152
# 4 GiB of uploads and crops on disk; over it, uploads return 507.
#LABELCHECK_MAX_DISK_BYTES=4294967296
# Retention. Batches older than this are deleted with all their files; the timer sweeps
# every 15 minutes. The page states the promise verbatim.
#LABELCHECK_PURGE_TTL_MIN=60

# --- Rate limiting (in-process, per IP) ------------------------------------------------------------
#LABELCHECK_RATE_PER_MIN=90
#LABELCHECK_RATE_PER_HOUR=900
